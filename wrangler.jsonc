{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matrix",
  "compatibility_date": "2026-07-20",
  "main": "./worker.js",
  "vars": {
    "WIX_SITE_ID": "11d3f5bd-efda-4bb6-ad57-5f0b4151e3d6"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
